# Local: disable SSL. Production (Vercel + Supabase): use Connect → Session pooler (not Direct), e.g.:
# DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/daystack?sslmode=disable
PORT=8080
# Same-origin in production (frontend and backend share one Vercel domain), so this
# is mainly for local dev where the Vite dev server runs on a different port:
# ALLOWED_ORIGIN=http://localhost:5173
